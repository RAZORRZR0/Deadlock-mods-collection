<root>
	<styles>
		<include src="s2r://panorama/styles/base.vcss_c" />
		<include src="s2r://panorama/styles/citadel_base_styles.vcss_c" />
		<include src="s2r://panorama/styles/hero_testing_menu.vcss_c" />
	</styles>
	<scripts>
		<include src="s2r://panorama/scripts/hud_hero_testing.vjs_c" />
	</scripts>
	<CitadelHudHeroTesting class="hud_hero_testing_root">
		<GlobalClassListener classes="gScoreboardOpen gShopOpen" />
		<Panel id="hero_testing_stub">

			<!-- Dev Console: always visible at top -->
			<Panel class="dev_console_container">
				<Label class="dev_console_label" text="Dev Console" />
				<TextEntry id="DevConsoleInput" class="dev_console_input" placeholder=">_" oninputsubmit="DevConsoleSubmit();" />
			</Panel>

			<!-- Prompt shown when NOT holding TAB -->
			<Panel class="testing_prompt">
				<Label text="#HeroTesting_HoldAlt" html="true" />
			</Panel>

			<!-- Full menu: shown when holding TAB and expanded -->
			<Panel id="hero_tools" class="nav_menu_tab_contents">

				<!-- Hero Tools -->
				<Panel class="nav_menu_item_header">
					<Label text="#HeroTesting_HeroTools" />
					<Panel class="dash" />
				</Panel>
				<Panel class="nav_menu_item_container">
					<Button class="nav_menu_item small_text half_width" onactivate="HeroTestingChangeHero();">
						<Label text="#HeroTesting_ChangeHero" />
					</Button>
					<Button class="nav_menu_item small_text half_width" onactivate="HeroTestingChangeTeam();">
						<Label text="#HeroTesting_ChangeTeam" />
					</Button>
				</Panel>
				<Panel class="nav_menu_item_container">
					<Button class="nav_menu_item small_text half_width" onactivate="CitadelConCommand( 'resetme' ); PlaySoundEffect( Stinger.LevelUp )">
						<Label text="#HeroTesting_ResetHero" />
					</Button>
				</Panel>
				<Panel class="nav_menu_item_container">
					<Button class="small_text nav_menu_item half_width" onactivate="CitadelConCommand( 'givelevelupgold 1' ); PlaySoundEffect( Stinger.LevelUp )">
						<Label text="#HeroTesting_LevelUp" />
					</Button>
					<Button class="small_text nav_menu_item half_width" onactivate="CitadelConCommand( 'givelevelupgold 36' ); PlaySoundEffect( Stinger.LevelUp )">
						<Label text="#HeroTesting_MaxLevel" />
					</Button>
				</Panel>
				<Panel class="nav_menu_item_container">
					<Button class="small_text nav_menu_item half_width" onactivate="CitadelConCommand( 'healthpct 50' ); PlaySoundEffect( Stinger.LevelUp )">
						<Label text="#HeroTesting_HalfHealth" />
					</Button>
					<Button class="small_text nav_menu_item half_width" onactivate="CitadelConCommand( 'healthpct 100' ); PlaySoundEffect( Stinger.LevelUp )">
						<Label text="#HeroTesting_FullHealth" />
					</Button>
				</Panel>
				<Panel class="nav_menu_item_container">
					<Button class="nav_menu_item small_text half_width" onactivate="CitadelConCommand( 'lethaldamageme' ); PlaySoundEffect( Stinger.LevelUp )">
						<Label text="#HeroTesting_KillHero" />
					</Button>
					<Button class="nav_menu_item small_text half_width" onactivate="CitadelConCommand( 'giveallupgrades' ); PlaySoundEffect( Stinger.LevelUp )">
						<Label text="#HeroTesting_AllPerks" />
					</Button>
				</Panel>
				<Panel class="nav_menu_item_container">
					<Button class="nav_menu_item small_text half_width" onactivate="CitadelConCommand( 'citadel_spawn_nearby_neutrals' ); PlaySoundEffect( Stinger.LevelUp )">
						<Label text="#HeroTesting_SpawnCamp" />
					</Button>
				</Panel>

				<!-- Game Rules -->
				<Panel class="nav_menu_item_header hideout_btns">
					<Label text="#HeroTesting_GameRules" />
					<Panel class="dash" />
				</Panel>
				<Panel class="nav_menu_item_container hideout_btns">
					<ToggleButton class="nav_menu_item CitadelSettingsCheckbox half_width" id="DisableDeathCheckbox" text="#HeroTesting_NoDeath" onactivate="HeroTestingUpdateDisableDeath(); PlaySoundEffect( Stinger.LevelUp )" />
					<ToggleButton class="nav_menu_item CitadelSettingsCheckbox half_width" id="EnableUnlimitedAmmoCheckbox" text="#HeroTesting_UnlimitedAmmo" onactivate="HeroTestingUpdateEnableUnlimitedAmmo()" />
				</Panel>
				<Panel class="nav_menu_item_container hideout_btns">
					<ToggleButton class="nav_menu_item CitadelSettingsCheckbox half_width" id="DisableCooldownCheckbox" text="#HeroTesting_NoCooldown" onactivate="HeroTestingUpdateDisableCooldowns()" />
					<ToggleButton class="nav_menu_item CitadelSettingsCheckbox half_width" id="EnableFastStaminaCheckbox" text="#HeroTesting_FastStamina" onactivate="HeroTestingUpdateEnableFastStamina()" />
				</Panel>
				<Panel class="nav_menu_item_container hide_in_coop">
					<Button class="small_text nav_menu_item third_width" onactivate="CitadelConCommand( 'host_timescale_dec' ); PlaySoundEffect( Stinger.LevelUp )">
						<Label text="#HeroTesting_SpeedDown" />
					</Button>
					<Button class="small_text nav_menu_item third_width" onactivate="CitadelConCommand( 'host_timescale 1.0' ); PlaySoundEffect( Stinger.LevelUp )">
						<Label text="#HeroTesting_SpeedNormal" />
					</Button>
					<Button class="small_text nav_menu_item third_width" onactivate="CitadelConCommand( 'host_timescale_inc' ); PlaySoundEffect( Stinger.LevelUp )">
						<Label text="#HeroTesting_SpeedUp" />
					</Button>
				</Panel>

				<!-- Play & Watch -->
				<Panel class="nav_menu_item_header">
					<Label text="Play &amp; Watch" />
					<Panel class="dash" />
				</Panel>
				<Panel class="nav_menu_item_container">
					<Button class="nav_menu_item small_text half_width" onactivate="CitadelShowPlayPage();">
						<Label text="#menu_play" />
					</Button>
					<Button class="nav_menu_item small_text half_width" onactivate="CitadelShowWatchPage( true );">
						<Label text="#menu_watch" />
					</Button>
				</Panel>

				<Panel class="nav_menu_item_header">
					<Label text="#HeroTesting_HeroControl" />
					<Panel class="dash" />
				</Panel>
				<Panel class="nav_menu_item_container">
					<Button class="nav_menu_item small_text half_width" onactivate="CitadelConCommand( 'citadel_assume_pawn_control' );">
						<Label text="#HeroTesting_TakeControl" />
					</Button>
					<Button class="nav_menu_item small_text half_width" onactivate="CitadelConCommand( 'bot_kick_all' );">
						<Label text="#HeroTesting_RemoveBots" />
					</Button>
				</Panel>
				<Panel class="nav_menu_item_container">
					<Panel class="nav_menu_item_container vertical_item">
						<Panel class="small_text full_width">
							<Label text="#HeroTesting_HeroToSpawn" />
						</Panel>
						<Button class="nav_menu_item small_text full_width" onactivate="HeroTestingSpawnBotHero('enemy')">
							<Label text="#HeroTesting_SpawnEnemy" />
						</Button>
						<Button class="nav_menu_item small_text full_width" onactivate="HeroTestingSpawnBotHero('friend')">
							<Label text="#HeroTesting_SpawnFriendly" />
						</Button>
					</Panel>
					<CitadelHeroCard id="SpawnBotCard" onactivate="HeroTestingChangeSelectedBot();" />
				</Panel>
				<Panel class="nav_menu_item_container hide_in_coop">
					<Button class="nav_menu_item small_text half_width" onactivate="CitadelConCommand( 'bot_mimic_target' );">
						<Label text="#HeroTesting_MakeMimic" />
					</Button>
					<Button class="nav_menu_item small_text half_width" onactivate="CitadelConCommand( 'bot_puppet_target' );">
						<Label text="#HeroTesting_MakePuppet" />
					</Button>
				</Panel>
				<Panel class="nav_menu_item_container hide_in_coop">
					<Button class="nav_menu_item small_text full_width" onactivate="CitadelConCommand( 'bot_mimic 0' ); CitadelConCommand( ' bot_puppet 0' );">
						<Label text="#HeroTesting_ClearFollow" />
					</Button>
				</Panel>

			</Panel>

			<!-- Expand / Collapse toggle button -->
			<Panel id="collapse_menu_panel">
				<Button id="collapse_button" class="nav_menu_item_small_text" onactivate="HeroTestingToggleMenuExpanded();">
					<Label class="expand_label" text="#DevMenu_Expand" />
					<Label class="collapse_label" text="#DevMenu_Collapse" />
					<Image id="collapse_icon" src="s2r://panorama/images/icons/icon_carat.vsvg" />
				</Button>
			</Panel>

			<!-- Engine-required panels (must exist, kept hidden) -->
			<Panel id="hero_testing_tabs" class="tab_selector">
				<Panel class="LeftRightFlow tab_wrapper">
					<RadioButton group="HeroTestingTabButtons" class="hero_testing_tab" selected="true" onactivate="HeroTestingSelectTab(&apos;hero_tools&apos;);" id="hero_tools_button" text="#HeroTesting_HeroTools" />
				</Panel>
				<Panel class="LeftRightFlow tab_wrapper">
					<RadioButton group="HeroTestingTabButtons" class="hero_testing_tab" onactivate="HeroTestingSelectTab(&apos;game_rules&apos;);" id="game_rules_button" text="#HeroTesting_GameRules" />
				</Panel>
				<Panel class="LeftRightFlow tab_wrapper">
					<RadioButton group="HeroTestingTabButtons" class="hero_testing_tab" onactivate="HeroTestingSelectTab(&apos;hero_control&apos;);" id="hero_control_button" text="#HeroTesting_HeroControl" />
				</Panel>
			</Panel>
			<Panel id="game_rules" class="nav_menu_tab_contents" />
			<Panel id="LaneChallengePanel">
				<Panel class="nav_menu_item_header">
					<Label text="#HeroTesting_LaneChallenge" />
				</Panel>
				<Label class="lane_challenge" text="#HeroTesting_LastHits" />
				<Label class="lane_challenge" text="#HeroTesting_OrbsSecured" />
				<Label class="lane_challenge" text="#HeroTesting_OrbsDenied" />
			</Panel>

		</Panel>
	</CitadelHudHeroTesting>
</root>
